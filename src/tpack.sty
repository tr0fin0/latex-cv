\newcommand{\skills}{
    % requires 'iflang'
    \IfLanguageName{english}{Skills}{
        \IfLanguageName{french}{Compétences}{
            \IfLanguageName{portuguese}{Habilidades}{
                not defined
            }
        }
    }
}

\newcommand{\version}{
    % requires 'iflang'
    \IfLanguageName{english}{[EN VERSION]}{
        \IfLanguageName{french}{[FR VERSION]}{
            \IfLanguageName{portuguese}{[PT-BR VERSION]}{
                not defined
            }
        }
    }
}



% ----------------------------------------------
%               Commands with Arguments
% ----------------------------------------------

\newcommand{\block}[6]{%
    \subsection*{#1\hfill #4}%
    \noindent \textcolor{color_text}{#2\hfill #3}\par
    \if\relax\detokenize{#5}\relax
        % empty description
    \else
        \vspace{2mm}%
        {\color{color_text}#5\par}%
        \sbox0{#6}%
        \ifdim\wd0=0pt
            % empty skills (does nothing)
        \else
            \vspace{2mm}%
            \noindent\highlight{\skills}{#6}\par
        \fi
    \fi
}

\newcommand{\colorbar}[2]{%
    % requires 'tikz'
    \begin{tikzpicture}[baseline]
        \fill[color=color_highlight] (0,0) rectangle ({#2/100*\linewidth}, #1mm);
        \draw[thick, color=color_text] (0,0) rectangle (\linewidth, #1mm);
    \end{tikzpicture}%
}

\newcommand{\experience}[1]{
    \block{%
        \getIfTranslationExists{#1-site}%
    }{%
        \getIfTranslationExists{#1-title}%
    }{%
        \getIfTranslationExists{#1-location}%
    }{%
        \getIfTranslationExists{#1-duration}%
    }{%
        \getIfTranslationExists{#1-description}%
    }{%
        \getIfTranslationExists{#1-skills}%
    }
}

\newcommand{\getIfTranslationExists}[1]{%
    \IfTranslation{\languagename}{#1}{\GetTranslation{#1}}{}%
}

\newcommand{\highlight}[2]{%
    \if\relax\detokenize{#2}\relax
        % empty skills
    \else
        \textcolor{color_text}{\textbf{#1}}: \textcolor{color_text}{#2}%
    \fi
}

\newcommand{\idiom}[1]{%
    \highlight{%
        \getIfTranslationExists{#1-name}%
    }{%
        \hfill
        \getIfTranslationExists{#1-level}
        \textbf{\getIfTranslationExists{#1-cefr}}%
    }\\%
    \colorbar{1}{\getIfTranslationExists{#1-hbar}}%
}
