% ----------------------------------------------
%               Customization: Colors
% ----------------------------------------------

% https://htmlcolorcodes.com/fr/
\definecolor{color_highlight}{HTML}{873600} % default: #873600
\definecolor{color_text}{HTML}{505050}      % default: #505050
\definecolor{color_title}{HTML}{303030}     % default: #303030



% ----------------------------------------------
%               Customization: Geometry
% ----------------------------------------------

\geometry{margin=10mm}          % default: 10mm

\pagenumbering{gobble}

\setlength{\parindent}{0pt}


% ----------------------------------------------
%               Customization: Hyperlinks
% ----------------------------------------------

\contourlength{0.75pt}          % contour expansion length to mask underline



% ----------------------------------------------
%               Customization: Titles
% ----------------------------------------------

\titleformat
    {\section}                                      % Part
    [block]                                         % Part Shape
    {\color{color_highlight}\normalfont\bf\large}   % Font Size
    {}                                              % Label Numbering
    {0mm}                                           % Part Separation
    {}                                              % Code Before
    [{\color{color_highlight}\titlerule[0.25mm]}]   % Code After

\titleformat
    {\subsection}                                   % Part
    [block]                                         % Part Shape
    {\normalfont\normalsize}                        % Font Size
    {}                                              % Label Numbering
    {0mm}                                           % Part Separation
    {}                                              % Code Before
    []                                              % Code After

% https://www.ctan.org/pkg/titlesec
% \titlespacing*{<command>}{<left-space>}{<before-separation>}{<after-separation>}

\titlespacing*{\section}{0.0mm}{4.0mm}{2.0mm}       % default: {0.0mm}{4.0mm}{2.0mm}
\titlespacing*{\subsection}{0.0mm}{2.0mm}{0.0mm}    % default: {0.0mm}{4.0mm}{0.0mm}



